# Variáveis de ambiente obrigatórias — copie para .env e preencha antes de subir o serviço
# (nunca commite o .env com valores reais)

# Banco de dados PostgreSQL (com PostGIS)
DB_USERNAME=myuser
DB_PASSWORD=changeme

# Redis (Pub/Sub para localização em tempo real)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWKS do Cadastro (valida o Bearer recebido)
JWKS_URI=http://localhost:8080/oauth2/jwks

# Broker MQTT (ingestão de telemetria GPS)
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_CLIENT_ID=loc-consumer
MQTT_TOPICO=localizacao/ponto
MQTT_QOS=1

# Serviço APP (consulta de amizade para visibilidade AMIGOS)
SERVICO_APP_URL=http://localhost:8081

# DDL — dev: update | produção: validate
DDL_AUTO=update
